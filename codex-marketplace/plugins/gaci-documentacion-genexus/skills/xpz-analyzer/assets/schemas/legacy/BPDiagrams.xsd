<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:include schemaLocation="gxbasic.xsd"/>
  <xs:element name="ExportFile">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="KMW"/>
        <xs:element ref="Source"/>
        <xs:element ref="Actions"/>
        <xs:element ref="Objects"/>
        <xs:element ref="Attributes"/>
        <xs:element ref="Dependencies"/>
        <xs:element ref="ObjectsIdentityMapping"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Actions">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Objects">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Object"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Object" >
  	<xs:complexContent>
  		<xs:extension base="Object">
			<!-- BP Diagram -->
 	 		<xs:attribute name="type" fixed="b5f00807-9da8-4cf9-b408-7554f2b6a8ee"></xs:attribute>
  		</xs:extension>
  	</xs:complexContent>
  </xs:element>
  <xs:element name="Part">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0">
          <xs:element ref="DiagramDocument"/>
          <xs:element ref="InnerHtml"/>
          <xs:element ref="RelevantDataList"/>
        </xs:choice>
        <xs:element ref="Properties"/>
      </xs:sequence>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="DiagramDocument">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Layers"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Layers">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Layer"/>
      </xs:sequence>
      <xs:attribute name="defaultLayerId" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Layer">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Elements"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Elements">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="StartEvent"/>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="Connector"/>
          <xs:element ref="EndEvent"/>
          <xs:element ref="Gateway"/>
          <xs:element ref="IntermediateEvent"/>
          <xs:element ref="SubProcess"/>
          <xs:element ref="Task"/>
          <xs:element ref="TextAnnotation"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="StartEvent">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
        <xs:element ref="Ports"/>
      </xs:sequence>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Connector">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
      </xs:sequence>
      <xs:attribute name="fromId" use="required" type="xs:integer"/>
      <xs:attribute name="fromPortId" use="required" type="xs:integer"/>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="toId" use="required" type="xs:integer"/>
      <xs:attribute name="toPortId" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="EndEvent">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
        <xs:element ref="Ports"/>
      </xs:sequence>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Gateway">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
        <xs:element ref="Ports"/>
      </xs:sequence>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="IntermediateEvent">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
        <xs:element ref="Ports"/>
      </xs:sequence>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="SubProcess">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
        <xs:element ref="Events"/>
        <xs:element ref="Children"/>
        <xs:element ref="Ports"/>
      </xs:sequence>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Children">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Task">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
        <xs:element ref="Events"/>
        <xs:element ref="Ports"/>
      </xs:sequence>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="TextAnnotation">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
        <xs:element ref="GraphicalProperties"/>
        <xs:element ref="Ports"/>
      </xs:sequence>
      <xs:attribute name="guid" use="required" type="GUID"/>
      <xs:attribute name="id" use="required" type="xs:integer"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="InnerHtml" type="xs:string"/>
  <xs:element name="RelevantDataList">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Categories" type="xs:NCName"/>
  <xs:element name="Attributes">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Properties">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="Property"/>
      </xs:sequence>
      <xs:attribute name="Name"/>
      <xs:attribute name="PackageName" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="GraphicalProperties">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Property"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Ports">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Events">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Property">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="Value"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Name" type="xs:NCName"/>
  <xs:element name="Value" type="xs:string"/>
</xs:schema>
