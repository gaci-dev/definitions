<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="ExportFile">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="KMW"/>
        <xs:element ref="Source"/>
        <xs:element ref="Actions"/>
        <xs:element ref="Objects"/>
        <xs:element ref="Attributes"/>
        <xs:element ref="Dependencies"/>
        <xs:element ref="ObjectsIdentityMapping"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="KMW">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="MajorVersion"/>
        <xs:element ref="MinorVersion"/>
        <xs:element ref="Build"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="MajorVersion" type="xs:integer"/>
  <xs:element name="MinorVersion" type="xs:integer"/>
  <xs:element name="Build" type="xs:integer"/>
  <xs:element name="Actions">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Objects">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Object"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Object">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Part"/>
        <xs:element ref="Properties"/>
      </xs:sequence>
      <xs:attribute name="checksum" use="required"/>
      <xs:attribute name="description" use="required"/>
      <xs:attribute name="fullyQualifiedName" use="required" type="xs:NCName"/>
      <xs:attribute name="guid" use="required"/>
      <xs:attribute name="lastUpdate" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="name" use="required" type="xs:NCName"/>
      <xs:attribute name="parent" use="required" type="xs:NCName"/>
      <xs:attribute name="parentType" use="required"/>
      <xs:attribute name="type" use="required"/>
      <xs:attribute name="user" use="required"/>
      <xs:attribute name="versionDate" use="required" type="xs:NMTOKEN"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Part">
    <xs:complexType>
      <xs:sequence>
        <xs:choice>
          <xs:element ref="Help"/>
          <xs:element ref="Source"/>
          <xs:element ref="Document"/>
          <xs:element ref="InnerHtml"/>
          <xs:element minOccurs="0" maxOccurs="unbounded" ref="Variable"/>
        </xs:choice>
        <xs:element ref="Properties"/>
      </xs:sequence>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Document">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Form"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Form">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Type"/>
        <xs:element ref="Class"/>
        <xs:element ref="ClassGuid"/>
        <xs:element ref="SizeUnit"/>
        <xs:element ref="Info"/>
        <xs:element ref="Canvas"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Type" type="xs:NCName"/>
  <xs:element name="Class" type="xs:NCName"/>
  <xs:element name="ClassGuid" type="xs:string"/>
  <xs:element name="SizeUnit" type="xs:NCName"/>
  <xs:element name="Info">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Canvas">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Elements"/>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="InnerHtml" type="xs:string"/>
  <xs:element name="Variable">
    <xs:complexType>
      <xs:sequence minOccurs="0">
        <xs:element ref="Documentation"/>
        <xs:element ref="Help"/>
        <xs:element ref="Properties"/>
      </xs:sequence>
      <xs:attribute name="Name" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Documentation">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Attributes">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Dependencies">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Reference"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Reference">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
      <xs:attribute name="Id" use="required"/>
      <xs:attribute name="Package" use="required"/>
      <xs:attribute name="Type" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="ObjectsIdentityMapping">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element ref="ObjectIdentity"/>
        <xs:element ref="ObjectIdentityByTableComposition"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="ObjectIdentity">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Guid"/>
      </xs:sequence>
      <xs:attribute name="Name" use="required" type="xs:NCName"/>
      <xs:attribute name="Type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Guid" type="xs:string"/>
  <xs:element name="ObjectIdentityByTableComposition">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="KeyComposition"/>
      </xs:sequence>
      <xs:attribute name="Name" use="required" type="xs:NCName"/>
      <xs:attribute name="Type" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="KeyComposition">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Key"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Key" type="xs:string"/>
  <xs:element name="Source">
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="Version"/>
      </xs:sequence>
      <xs:attribute name="kb"/>
      <xs:attribute name="username"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Version">
    <xs:complexType>
      <xs:attribute name="guid" use="required"/>
      <xs:attribute name="name" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Help">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" ref="HelpItem"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="HelpItem">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Language"/>
        <xs:element ref="Content"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Language" type="xs:string"/>
  <xs:element name="Content" type="xs:string"/>
  <xs:element name="Properties">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="Property"/>
      </xs:sequence>
      <xs:attribute name="Name"/>
      <xs:attribute name="PackageName" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Property">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="Value"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Name" type="xs:NCName"/>
  <xs:element name="Value" type="xs:string"/>
  <xs:element name="Elements">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="Button"/>
          <xs:element ref="DataEntry"/>
          <xs:element ref="Image"/>
          <xs:element ref="Label"/>
          <xs:element ref="Line"/>
          <xs:element ref="Rect"/>
          <xs:element ref="Tab"/>
          <xs:element ref="TabPage"/>
        </xs:choice>
        <xs:sequence minOccurs="0">
          <xs:element ref="Grid"/>
          <xs:element maxOccurs="unbounded" ref="GridColumn"/>
        </xs:sequence>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Button">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DataEntry">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Image">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Label">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Line">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Rect">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Tab">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Elements"/>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="TabPage">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Elements"/>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Grid">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Elements"/>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="GridColumn">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Properties"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
