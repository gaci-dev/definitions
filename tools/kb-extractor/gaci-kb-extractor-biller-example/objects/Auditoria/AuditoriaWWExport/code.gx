/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

// Exports the contents of a grid (using the selected order and filters) to an Excel file.
LoadWWPContext.Call(&WWPContext)

Do 'OpenDocument'

&CellRow = 1
&FirstColumn = 1

Do 'LoadGridState'

Do 'WriteFilters'

Do 'WriteColumnTitles'

Do 'WriteData'

Do 'CloseDocument'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'OpenDocument'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Random = Random() * 10000
	&Filename = WWP_GetDefaultExportPath() + !"AuditoriaWWExport-" + &Random.ToString().Trim() + !".xlsx"

	&ExcelDocument.Open(&Filename)
	Do 'CheckStatus'
	&ExcelDocument.Clear()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'WriteFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not (&FilterFullText.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "WWP_FullTextFilterDescription")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(&FilterFullText)
	EndIf
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'AUDITORIATRN'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&AuditoriaTRN1.FromString(&GridStateDynamicFilter.Value)
				If not &AuditoriaTRN1.IsEmpty()
					&CellRow += 1
					&ExcelDocument.Cells(&CellRow, &FirstColumn).Bold = True
					&ExcelDocument.Cells(&CellRow, &FirstColumn).Color = 3
					Do Case
						Case &DynamicFiltersOperator1 = 0
							&ExcelDocument.Cells(&CellRow, &FirstColumn).Text = format('%1 (%2)', "Transaccion", "WWP_FilterLike")
						Case &DynamicFiltersOperator1 = 1
							&ExcelDocument.Cells(&CellRow, &FirstColumn).Text = format('%1 (%2)', "Transaccion", "WWP_FilterContains")
					EndCase
					&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Italic = True
					&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(&AuditoriaTRN1)		
				EndIf			
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'AUDITORIATRN'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&AuditoriaTRN2.FromString(&GridStateDynamicFilter.Value)
					If not &AuditoriaTRN2.IsEmpty()
						&CellRow += 1
						&ExcelDocument.Cells(&CellRow, &FirstColumn).Bold = True
						&ExcelDocument.Cells(&CellRow, &FirstColumn).Color = 3
						Do Case
							Case &DynamicFiltersOperator2 = 0
								&ExcelDocument.Cells(&CellRow, &FirstColumn).Text = format('%1 (%2)', "Transaccion", "WWP_FilterLike")
							Case &DynamicFiltersOperator2 = 1
								&ExcelDocument.Cells(&CellRow, &FirstColumn).Text = format('%1 (%2)', "Transaccion", "WWP_FilterContains")
						EndCase
						&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Italic = True
						&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(&AuditoriaTRN2)		
					EndIf			
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'AUDITORIATRN'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&AuditoriaTRN3.FromString(&GridStateDynamicFilter.Value)
						If not &AuditoriaTRN3.IsEmpty()
							&CellRow += 1
							&ExcelDocument.Cells(&CellRow, &FirstColumn).Bold = True
							&ExcelDocument.Cells(&CellRow, &FirstColumn).Color = 3
							Do Case
								Case &DynamicFiltersOperator3 = 0
									&ExcelDocument.Cells(&CellRow, &FirstColumn).Text = format('%1 (%2)', "Transaccion", "WWP_FilterLike")
								Case &DynamicFiltersOperator3 = 1
									&ExcelDocument.Cells(&CellRow, &FirstColumn).Text = format('%1 (%2)', "Transaccion", "WWP_FilterContains")
							EndCase
							&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Italic = True
							&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(&AuditoriaTRN3)		
						EndIf			
				EndCase
			EndIf
		EndIf
	EndIf
	If not (&TFAuditoriaTRN_Sel.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Transaccion")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(iif(&TFAuditoriaTRN_Sel.IsEmpty(), 'WWP_TitleFilter_EmptyOption', &TFAuditoriaTRN_Sel))
	Else
		If not (&TFAuditoriaTRN.IsEmpty())
			WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Transaccion")
			&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(&TFAuditoriaTRN)
		EndIf
	EndIf
	If not (&TFAuditoriaPK_Sel.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Clave Primaria")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(iif(&TFAuditoriaPK_Sel.IsEmpty(), 'WWP_TitleFilter_EmptyOption', Substr(&TFAuditoriaPK_Sel, 1, 1000)))
	Else
		If not (&TFAuditoriaPK.IsEmpty())
			WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Clave Primaria")
			&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(Substr(&TFAuditoriaPK, 1, 1000))
		EndIf
	EndIf
	If not (&TFAuditoriaATTR_Sel.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Atributo")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(iif(&TFAuditoriaATTR_Sel.IsEmpty(), 'WWP_TitleFilter_EmptyOption', &TFAuditoriaATTR_Sel))
	Else
		If not (&TFAuditoriaATTR.IsEmpty())
			WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Atributo")
			&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(&TFAuditoriaATTR)
		EndIf
	EndIf
	If not (&TFAuditoriaOldValue_Sel.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Valor Anterior")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(iif(&TFAuditoriaOldValue_Sel.IsEmpty(), 'WWP_TitleFilter_EmptyOption', Substr(&TFAuditoriaOldValue_Sel, 1, 1000)))
	Else
		If not (&TFAuditoriaOldValue.IsEmpty())
			WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Valor Anterior")
			&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(Substr(&TFAuditoriaOldValue, 1, 1000))
		EndIf
	EndIf
	If not (&TFAuditoriaValue_Sel.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Valor")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(iif(&TFAuditoriaValue_Sel.IsEmpty(), 'WWP_TitleFilter_EmptyOption', Substr(&TFAuditoriaValue_Sel, 1, 1000)))
	Else
		If not (&TFAuditoriaValue.IsEmpty())
			WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Valor")
			&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(Substr(&TFAuditoriaValue, 1, 1000))
		EndIf
	EndIf
	If not (&TFAuditoriaMode_Sels.Count = 0)
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Operacion Realizada")
		&i = 1
		For &TFAuditoriaMode_Sel in &TFAuditoriaMode_Sels
			If &i = 1
				&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = ''
			Else
				&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text += ', '
			EndIf
			&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text += WWP_Export_SecureText(iif(&TFAuditoriaMode_Sel.IsEmpty(), 'WWP_TitleFilter_EmptyOption', &TFAuditoriaMode_Sel))
			&i += 1
		EndFor
	EndIf
	If not (&TFAuditoriaUser_Sel.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Usuario")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(iif(&TFAuditoriaUser_Sel.IsEmpty(), 'WWP_TitleFilter_EmptyOption', &TFAuditoriaUser_Sel))
	Else
		If not (&TFAuditoriaUser.IsEmpty())
			WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "Usuario")
			&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Text = WWP_Export_SecureText(&TFAuditoriaUser)
		EndIf
	EndIf
	If not (&TFAuditoriaDateTime.IsEmpty() AND &TFAuditoriaDateTime_To.IsEmpty())
		WWP_ExportWriteFilter(&ExcelDocument, true, &CellRow, &FirstColumn, "del Evento")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 1).Date = &TFAuditoriaDateTime
		WWP_ExportWriteFilter(&ExcelDocument, false, &CellRow, &FirstColumn + 2, "WWP_TSTo")
		&ExcelDocument.Cells(&CellRow, &FirstColumn + 3).Date = &TFAuditoriaDateTime_To
	EndIf
	&CellRow += 2

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'WriteColumnTitles'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&VisibleColumnCount = 0
	If &Session.Get(!'Auditoria.AuditoriaWWColumnsSelector') <> ''
		&ColumnsSelectorXML = &Session.Get(!'Auditoria.AuditoriaWWColumnsSelector')
		&ColumnsSelector.FromXml(&ColumnsSelectorXML)
	Else
		Do 'InitializeColumnsSelector'
	EndIf

	For &ColumnsSelector_Column in &ColumnsSelector.Columns
		If &ColumnsSelector_Column.IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = GetMessageText(iif(&ColumnsSelector_Column.DisplayName.IsEmpty(), &ColumnsSelector_Column.ColumnName, &ColumnsSelector_Column.DisplayName))
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Bold = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Color = 11
			&VisibleColumnCount += 1
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'WriteData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For each Auditoria
		order AuditoriaTRN  when &OrderedBy = 1 AND &OrderedDsc = False
		order (AuditoriaTRN)  when &OrderedBy = 1 AND &OrderedDsc = True
		order AuditoriaPK  when &OrderedBy = 2 AND &OrderedDsc = False
		order (AuditoriaPK)  when &OrderedBy = 2 AND &OrderedDsc = True
		order AuditoriaATTR  when &OrderedBy = 3 AND &OrderedDsc = False
		order (AuditoriaATTR)  when &OrderedBy = 3 AND &OrderedDsc = True
		order AuditoriaOldValue  when &OrderedBy = 4 AND &OrderedDsc = False
		order (AuditoriaOldValue)  when &OrderedBy = 4 AND &OrderedDsc = True
		order AuditoriaValue  when &OrderedBy = 5 AND &OrderedDsc = False
		order (AuditoriaValue)  when &OrderedBy = 5 AND &OrderedDsc = True
		order AuditoriaMode  when &OrderedBy = 6 AND &OrderedDsc = False
		order (AuditoriaMode)  when &OrderedBy = 6 AND &OrderedDsc = True
		order AuditoriaUser  when &OrderedBy = 7 AND &OrderedDsc = False
		order (AuditoriaUser)  when &OrderedBy = 7 AND &OrderedDsc = True
		order AuditoriaDateTime  when &OrderedBy = 8 AND &OrderedDsc = False
		order (AuditoriaDateTime)  when &OrderedBy = 8 AND &OrderedDsc = True
		
		using AuditoriaWWDS(&FilterFullText, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &AuditoriaTRN1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2
					, &DynamicFiltersOperator2, &AuditoriaTRN2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &AuditoriaTRN3
					, &TFAuditoriaTRN, &TFAuditoriaTRN_Sel, &TFAuditoriaPK, &TFAuditoriaPK_Sel, &TFAuditoriaATTR, &TFAuditoriaATTR_Sel
					, &TFAuditoriaOldValue, &TFAuditoriaOldValue_Sel, &TFAuditoriaValue, &TFAuditoriaValue_Sel, &TFAuditoriaMode_Sels, &TFAuditoriaUser
					, &TFAuditoriaUser_Sel, &TFAuditoriaDateTime, &TFAuditoriaDateTime_To)

		// Write cell values
		&CellRow += 1
		
		Do 'BeforeWriteLine'
		&VisibleColumnCount = 0
		If &ColumnsSelector.Columns.Item(1).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = WWP_Export_SecureText(AuditoriaTRN)
			&VisibleColumnCount += 1
		EndIf
		If &ColumnsSelector.Columns.Item(2).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = WWP_Export_SecureText(Substr(AuditoriaPK, 1, 1000))
			&VisibleColumnCount += 1
		EndIf
		If &ColumnsSelector.Columns.Item(3).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = WWP_Export_SecureText(AuditoriaATTR)
			&VisibleColumnCount += 1
		EndIf
		If &ColumnsSelector.Columns.Item(4).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = WWP_Export_SecureText(Substr(AuditoriaOldValue, 1, 1000))
			&VisibleColumnCount += 1
		EndIf
		If &ColumnsSelector.Columns.Item(5).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = WWP_Export_SecureText(Substr(AuditoriaValue, 1, 1000))
			&VisibleColumnCount += 1
		EndIf
		If &ColumnsSelector.Columns.Item(6).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = WWP_Export_SecureText(AuditoriaMode)
			&VisibleColumnCount += 1
		EndIf
		If &ColumnsSelector.Columns.Item(7).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Text = WWP_Export_SecureText(AuditoriaUser)
			&VisibleColumnCount += 1
		EndIf
		If &ColumnsSelector.Columns.Item(8).IsVisible = True
			&ExcelDocument.Cells(&CellRow, &FirstColumn + &VisibleColumnCount).Date = AuditoriaDateTime
			&VisibleColumnCount += 1
		EndIf
		
		Do 'AfterWriteLine'

	Endfor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'CloseDocument'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ExcelDocument.Save()
	Do 'CheckStatus'
	&ExcelDocument.Close()
	&Session.Set(!'WWPExportFilePath', &Filename)
	&Session.Set(!'WWPExportFileName', !"AuditoriaWWExport.xlsx")
	&Filename = WWP_DownloadReport.Link()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'CheckStatus'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&ExcelDocument.ErrCode <> 0)
		&Filename = ""
		&ErrorMessage = &ExcelDocument.ErrDescription
		&ExcelDocument.Close()
		Return
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'InitializeColumnsSelector'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ColumnsSelector = new WWPColumnsSelector()
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaTRN", '', !'Transaccion', True, '')
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaPK", '', !'Clave Primaria', True, '')
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaATTR", '', !'Atributo', True, '')
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaOldValue", '', !'Valor Anterior', True, '')
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaValue", '', !'Valor', True, '')
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaMode", '', !'Operacion Realizada', True, '')
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaUser", '', !'Usuario', True, '')
	WWP_ColumnsSelector_Add(&ColumnsSelector, !"AuditoriaDateTime", '', !'del Evento', True, '')
		
	&UserCustomValue = LoadColumnsSelectorState.Udp(!'Auditoria.AuditoriaWWColumnsSelector')
	If not(&UserCustomValue.IsEmpty())
		&ColumnsSelectorAux.FromXml(&UserCustomValue)
		WWP_ColumnSelector_UpdateColumns(&ColumnsSelectorAux, &ColumnsSelector)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"Auditoria.AuditoriaWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"Auditoria.AuditoriaWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"Auditoria.AuditoriaWWGridState"))
	Endif	

	&OrderedBy = &GridState.OrderedBy
	&OrderedDsc = &GridState.OrderedDsc

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"FILTERFULLTEXT"
				&FilterFullText.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIATRN"
				&TFAuditoriaTRN.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIATRN_SEL"
				&TFAuditoriaTRN_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAPK"
				&TFAuditoriaPK.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAPK_SEL"
				&TFAuditoriaPK_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAATTR"
				&TFAuditoriaATTR.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAATTR_SEL"
				&TFAuditoriaATTR_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAOLDVALUE"
				&TFAuditoriaOldValue.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAOLDVALUE_SEL"
				&TFAuditoriaOldValue_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAVALUE"
				&TFAuditoriaValue.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAVALUE_SEL"
				&TFAuditoriaValue_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAMODE_SEL"
				&TFAuditoriaMode_SelsJson = &GridStateFilterValue.Value
				&TFAuditoriaMode_Sels.FromJson(&TFAuditoriaMode_SelsJson)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAUSER"
				&TFAuditoriaUser.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAUSER_SEL"
				&TFAuditoriaUser_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIADATETIME"
				&TFAuditoriaDateTime.FromString(&GridStateFilterValue.Value)
				&TFAuditoriaDateTime_To.FromString(&GridStateFilterValue.ValueTo)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'BeforeWriteLine'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'AfterWriteLine'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub
