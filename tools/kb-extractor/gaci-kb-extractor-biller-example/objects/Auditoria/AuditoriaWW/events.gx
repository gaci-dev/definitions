	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&AuditoriaTRN3.Visible = False
	&DynamicFiltersOperator3.Visible = False
	Do Case
	Case &DynamicFiltersSelector3 = !'AUDITORIATRN'
		&AuditoriaTRN3.Visible = True
		&DynamicFiltersOperator3.Visible = True
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'ResetDynFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&DynamicFiltersEnabled2 = False
	&DynamicFiltersSelector2 = !'AUDITORIATRN'
	&DynamicFiltersOperator2 = 0
	&AuditoriaTRN2.SetEmpty()
	Do 'EnableDynamicFilters2'

	&DynamicFiltersEnabled3 = False
	&DynamicFiltersSelector3 = !'AUDITORIATRN'
	&DynamicFiltersOperator3 = 0
	&AuditoriaTRN3.SetEmpty()
	Do 'EnableDynamicFilters3'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadSavedFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ManageFiltersData = WWP_ManageFiltersLoadSavedFilters(!'Auditoria.AuditoriaWWFilters', !"WWPDynFilterHideAll_AL('%1', 3, 0)", TableDynamicFilters.InternalName, True)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'CleanFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&FilterFullText.SetEmpty()
	&TFAuditoriaTRN.SetEmpty()
	&TFAuditoriaTRN_Sel.SetEmpty()
	&TFAuditoriaPK.SetEmpty()
	&TFAuditoriaPK_Sel.SetEmpty()
	&TFAuditoriaATTR.SetEmpty()
	&TFAuditoriaATTR_Sel.SetEmpty()
	&TFAuditoriaOldValue.SetEmpty()
	&TFAuditoriaOldValue_Sel.SetEmpty()
	&TFAuditoriaValue.SetEmpty()
	&TFAuditoriaValue_Sel.SetEmpty()
	&TFAuditoriaMode_Sels = new()
	&TFAuditoriaUser.SetEmpty()
	&TFAuditoriaUser_Sel.SetEmpty()
	&TFAuditoriaDateTime.SetEmpty()
	&TFAuditoriaDateTime_To.SetEmpty()
	DDO_Grid.SelectedValue_set = ''
	DDO_Grid.FilteredText_set = ''
	DDO_Grid.FilteredTextTo_set = ''

	&DynamicFiltersSelector1 = !'AUDITORIATRN'
	&DynamicFiltersOperator1 = 0
	&AuditoriaTRN1.SetEmpty()
	Do 'EnableDynamicFilters1'
	Do 'ResetDynFilters'
	&GridState.DynamicFilters.Clear()
	Do 'LoadDynFiltersState'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'Do Display'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	AuditoriaView.Call(AuditoriaGUID, '')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

