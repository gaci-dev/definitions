Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	TFAuditoriaDateTime_RangePicker.Attach(&DDO_AuditoriaDateTimeAuxDateText.InternalName)
	
	Grid.Rows = Page.Rows
	Grid_Empowerer.GridInternalName = Grid.InternalName
	DDO_GridColumnsSelector.GridInternalName = Grid.InternalName

	If &HTTPRequest.Method = HttpMethod.Get
		Do 'LoadSavedFilters'
	EndIf

	JSDynamicFilters.Caption = ''
	&DynamicFiltersSelector1 = !'AUDITORIATRN'
	Do 'EnableDynamicFilters1'
	&DynamicFiltersSelector2 = !'AUDITORIATRN'
	Do 'EnableDynamicFilters2'
	&DynamicFiltersSelector3 = !'AUDITORIATRN'
	Do 'EnableDynamicFilters3'
	
	AddDynamicFilters1.JSEvent('onclick', format(!"WWPDynFilterShow_AL('%1', 2, 0)", TableDynamicFilters.InternalName))
	RemoveDynamicFilters1.JSEvent('onclick', format(!"WWPDynFilterHideLast_AL('%1', 3, 0)", TableDynamicFilters.InternalName))
	AddDynamicFilters2.JSEvent('onclick', format(!"WWPDynFilterShow_AL('%1', 3, 0)", TableDynamicFilters.InternalName))
	RemoveDynamicFilters2.JSEvent('onclick', format(!"WWPDynFilterHideLast_AL('%1', 3, 0)", TableDynamicFilters.InternalName))
	RemoveDynamicFilters3.JSEvent('onclick', format(!"WWPDynFilterHideLast_AL('%1', 3, 0)", TableDynamicFilters.InternalName))
	ddo_AGExport.TitleControlIdToReplace = BtnAGExport.InternalName
	&AGExportData = new()
	
	&AGExportDataItem = new()
	&AGExportDataItem.Title = 'WWP_ExportCaption'
	&AGExportDataItem.Icon = ActionExport.Link()
	&AGExportDataItem.EventKey = !'Export'
	&AGExportDataItem.IsDivider = False
	&AGExportData.Add(&AGExportDataItem)
	
	&AGExportDataItem = new()
	&AGExportDataItem.Title = 'WWP_ExportReportCaption'
	&AGExportDataItem.Icon = ActionExportReport.Link()
	&AGExportDataItem.EventKey = !'ExportReport'
	&AGExportDataItem.IsDivider = False
	&AGExportData.Add(&AGExportDataItem)
	
	DDO_Grid.GridInternalName = Grid.InternalName
	Form.Caption = ' Auditoria'

	Do 'PrepareTransaction'
	Do 'LoadGridState'
	If &OrderedBy < 1
		&OrderedBy = 1
		Do 'SetDDOSortedStatus'
	EndIf
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	DDO_GridColumnsSelector.TitleControlIdToReplace = BtnEditColumns.InternalName
	GridPaginationBar.RowsPerPageSelectedValue = Grid.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)

	Do Case
		Case &ManageFiltersExecutionStep = 1
			&ManageFiltersExecutionStep = 2
		Case &ManageFiltersExecutionStep = 2
			&ManageFiltersExecutionStep = 0
			Do 'LoadSavedFilters'
	EndCase
	Do 'SaveGridState'

	
	If &Session.Get(!'Auditoria.AuditoriaWWColumnsSelector') <> ''
		&ColumnsSelectorXML = &Session.Get(!'Auditoria.AuditoriaWWColumnsSelector')
		&ColumnsSelector.FromXml(&ColumnsSelectorXML)
	Else
		Do 'InitializeColumnsSelector'
	EndIf
	&AuditoriaTRNWithTags.Visible = &ColumnsSelector.Columns.Item(1).IsVisible
	AuditoriaPK.Visible = &ColumnsSelector.Columns.Item(2).IsVisible
	AuditoriaATTR.Visible = &ColumnsSelector.Columns.Item(3).IsVisible
	AuditoriaOldValue.Visible = &ColumnsSelector.Columns.Item(4).IsVisible
	AuditoriaValue.Visible = &ColumnsSelector.Columns.Item(5).IsVisible
	AuditoriaMode.Visible = &ColumnsSelector.Columns.Item(6).IsVisible
	AuditoriaUser.Visible = &ColumnsSelector.Columns.Item(7).IsVisible
	AuditoriaDateTime.Visible = &ColumnsSelector.Columns.Item(8).IsVisible
	&GridCurrentPage = Grid.CurrentPage
	&GridPageCount = Grid.PageCount
	&GridAppliedFilters = WWP_GetAppliedFiltersDescription(&Pgmname)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridPaginationBar.SelectedPage = !'Previous'
			Grid.PreviousPage()
		Case GridPaginationBar.SelectedPage = !'Next'
			Grid.NextPage()
		Otherwise
			&PageToGo.FromString(GridPaginationBar.SelectedPage)
			Grid.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid.Rows = GridPaginationBar.RowsPerPageSelectedValue
	Grid.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DDO_Grid.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case DDO_Grid.ActiveEventKey = !'<#OrderASC#>' OR DDO_Grid.ActiveEventKey = !'<#OrderDSC#>'
			&OrderedBy.FromString(DDO_Grid.SelectedValue_get)
			&OrderedDsc = iif(DDO_Grid.ActiveEventKey = !'<#OrderDSC#>', true, false)
			Do 'SetDDOSortedStatus'
			Grid.FirstPage()
		Case DDO_Grid.ActiveEventKey = !'<#Filter#>'
			Do Case
				Case DDO_Grid.SelectedColumn = !'AuditoriaTRN'
					&TFAuditoriaTRN = DDO_Grid.FilteredText_get
					&TFAuditoriaTRN_Sel = DDO_Grid.SelectedValue_get
				Case DDO_Grid.SelectedColumn = !'AuditoriaPK'
					&TFAuditoriaPK = DDO_Grid.FilteredText_get
					&TFAuditoriaPK_Sel = DDO_Grid.SelectedValue_get
				Case DDO_Grid.SelectedColumn = !'AuditoriaATTR'
					&TFAuditoriaATTR = DDO_Grid.FilteredText_get
					&TFAuditoriaATTR_Sel = DDO_Grid.SelectedValue_get
				Case DDO_Grid.SelectedColumn = !'AuditoriaOldValue'
					&TFAuditoriaOldValue = DDO_Grid.FilteredText_get
					&TFAuditoriaOldValue_Sel = DDO_Grid.SelectedValue_get
				Case DDO_Grid.SelectedColumn = !'AuditoriaValue'
					&TFAuditoriaValue = DDO_Grid.FilteredText_get
					&TFAuditoriaValue_Sel = DDO_Grid.SelectedValue_get
				Case DDO_Grid.SelectedColumn = !'AuditoriaMode'
					&TFAuditoriaMode_SelsJson = DDO_Grid.SelectedValue_get
					&TFAuditoriaMode_Sels.FromJson(&TFAuditoriaMode_SelsJson)
				Case DDO_Grid.SelectedColumn = !'AuditoriaUser'
					&TFAuditoriaUser = DDO_Grid.FilteredText_get
					&TFAuditoriaUser_Sel = DDO_Grid.SelectedValue_get
				Case DDO_Grid.SelectedColumn = !'AuditoriaDateTime'
					&TFAuditoriaDateTime.FromString(DDO_Grid.FilteredText_get)
					&TFAuditoriaDateTime_To.FromString(DDO_Grid.FilteredTextTo_get)
					If Not &TFAuditoriaDateTime_To.IsEmpty()
						&TFAuditoriaDateTime_To.Set(&TFAuditoriaDateTime_To.Year(), &TFAuditoriaDateTime_To.Month(), &TFAuditoriaDateTime_To.Day(), 23, 59, 59)
					EndIf
			EndCase
			Grid.FirstPage()
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridActions.Clear()
	&GridActions.AddItem(0, !";fa fa-bars")
	&GridActions.AddItem(1, format(!'%1;%2', "GXM_display", !"fa fa-search"))
	&GridActions.AddItem(2, format(!'%1;%2', "GXM_update", !"fa fa-pen"))
	&GridActions.AddItem(3, format(!'%1;%2', "GX_BtnDelete", !"fa fa-times"))
	
	&AuditoriaTRNWithTags = WWP_EncodeHTML(AuditoriaTRN)
	If AuditoriaMode='UPD'
		&AuditoriaTRNWithTags += format(!"<span class='AttributeTagWarning TagAfterText'>%1</span>", "Modificado")
	EndIf
	If AuditoriaMode='DLT'
		&AuditoriaTRNWithTags += format(!"<span class='AttributeTagDanger TagAfterText'>%1</span>", "Eliminado")
	EndIf
	If AuditoriaMode='INS'
		&AuditoriaTRNWithTags += format(!"<span class='AttributeTagSuccess TagAfterText'>%1</span>", "Alta")
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DDO_GridColumnsSelector.OnColumnsChanged

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ColumnsSelectorXML = DDO_GridColumnsSelector.ColumnsSelectorValues
	&ColumnsSelector.FromJson(&ColumnsSelectorXML)
	SaveColumnsSelectorState(!'Auditoria.AuditoriaWWColumnsSelector', iif(&ColumnsSelectorXML.IsEmpty(), '', &ColumnsSelector.ToXml()))
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'AddDynamicFilters1'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&DynamicFiltersEnabled2 = True
	AddDynamicFilters1.Visible = False
	RemoveDynamicFilters1.Visible = True

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'RemoveDynamicFilters1'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&DynamicFiltersRemoving = True
	&DynamicFiltersIgnoreFirst = True
	Do 'SaveDynFiltersState'
	Do 'ResetDynFilters'
	Do 'LoadDynFiltersState'
	&DynamicFiltersRemoving = False
	&DynamicFiltersIgnoreFirst = False
	Grid.Refresh()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

