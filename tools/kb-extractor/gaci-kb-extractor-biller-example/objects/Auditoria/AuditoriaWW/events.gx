EndSub

Sub 'Do Delete'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Auditoria.Auditoria.Call(TrnMode.Delete, AuditoriaGUID)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(&PgmName + !"GridState") = !""
		&GridState.FromXml(LoadGridState.Udp(&PgmName + !"GridState"))
	Else
		&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))
	Endif	

	&OrderedBy = &GridState.OrderedBy
	&OrderedDsc = &GridState.OrderedDsc
	Do 'SetDDOSortedStatus'
	Do 'LoadRegFiltersState'
	Do 'LoadDynFiltersState'
	If not &GridState.PageSize.Trim().IsEmpty()
		Grid.Rows = &GridState.PageSize.ToNumeric()
	EndIf
	Grid.CurrentPage = &GridState.CurrentPage

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadRegFiltersState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"FILTERFULLTEXT"
				&FilterFullText.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIATRN"
				&TFAuditoriaTRN.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIATRN_SEL"
				&TFAuditoriaTRN_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAPK"
				&TFAuditoriaPK.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAPK_SEL"
				&TFAuditoriaPK_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAATTR"
				&TFAuditoriaATTR.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAATTR_SEL"
				&TFAuditoriaATTR_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAOLDVALUE"
				&TFAuditoriaOldValue.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAOLDVALUE_SEL"
				&TFAuditoriaOldValue_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAVALUE"
				&TFAuditoriaValue.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAVALUE_SEL"
				&TFAuditoriaValue_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAMODE_SEL"
				&TFAuditoriaMode_SelsJson = &GridStateFilterValue.Value
				&TFAuditoriaMode_Sels.FromJson(&TFAuditoriaMode_SelsJson)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAUSER"
				&TFAuditoriaUser.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIAUSER_SEL"
				&TFAuditoriaUser_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAUDITORIADATETIME"
				&TFAuditoriaDateTime.FromString(&GridStateFilterValue.Value)
				&TFAuditoriaDateTime_To.FromString(&GridStateFilterValue.ValueTo)
					&DDO_AuditoriaDateTimeAuxDate = &TFAuditoriaDateTime
					&DDO_AuditoriaDateTimeAuxDateTo = &TFAuditoriaDateTime_To
		EndCase
	EndFor
	DDO_Grid.SelectedValue_set = WWP_GetFilterVal(&TFAuditoriaTRN_Sel.IsEmpty(), &TFAuditoriaTRN_Sel) + !'|' + WWP_GetFilterVal(&TFAuditoriaPK_Sel.IsEmpty(), &TFAuditoriaPK_Sel) + !'|' + WWP_GetFilterVal(&TFAuditoriaATTR_Sel.IsEmpty(), &TFAuditoriaATTR_Sel) + !'|' + WWP_GetFilterVal(&TFAuditoriaOldValue_Sel.IsEmpty(), &TFAuditoriaOldValue_Sel) + !'|' + WWP_GetFilterVal(&TFAuditoriaValue_Sel.IsEmpty(), &TFAuditoriaValue_Sel) + !'|' + WWP_GetFilterVal(&TFAuditoriaMode_Sels.Count = 0, &TFAuditoriaMode_SelsJson) + !'|' + WWP_GetFilterVal(&TFAuditoriaUser_Sel.IsEmpty(), &TFAuditoriaUser_Sel) + !'|'
	DDO_Grid.FilteredText_set = WWP_GetFilterVal(&TFAuditoriaTRN.IsEmpty(), &TFAuditoriaTRN) + !'|' + WWP_GetFilterVal(&TFAuditoriaPK.IsEmpty(), &TFAuditoriaPK) + !'|' + WWP_GetFilterVal(&TFAuditoriaATTR.IsEmpty(), &TFAuditoriaATTR) + !'|' + WWP_GetFilterVal(&TFAuditoriaOldValue.IsEmpty(), &TFAuditoriaOldValue) + !'|' + WWP_GetFilterVal(&TFAuditoriaValue.IsEmpty(), &TFAuditoriaValue) + !'||' + WWP_GetFilterVal(&TFAuditoriaUser.IsEmpty(), &TFAuditoriaUser) + !'|' + iif(&TFAuditoriaDateTime.IsEmpty(), '', &DDO_AuditoriaDateTimeAuxDate.ToString())
	DDO_Grid.FilteredTextTo_set = !'|||||||' + iif(&TFAuditoriaDateTime_To.IsEmpty(), '', &DDO_AuditoriaDateTimeAuxDateTo.ToString())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadDynFiltersState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	AddDynamicFilters1.Visible = True
	RemoveDynamicFilters1.Visible = False
	AddDynamicFilters2.Visible = True
	RemoveDynamicFilters2.Visible = False

	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'AUDITORIATRN'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&AuditoriaTRN1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		Do 'EnableDynamicFilters1'
			If &GridState.DynamicFilters.Count >= 2
				JSDynamicFilters.Caption = !'<script type="text/javascript">$(document).ready(function() {'
				JSDynamicFilters.Caption += format(!"WWPDynFilterShow_AL('%1', 2, 0);", TableDynamicFilters.InternalName)
				AddDynamicFilters1.Visible = False
				RemoveDynamicFilters1.Visible = True
				&DynamicFiltersEnabled2 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
				&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector2 = !'AUDITORIATRN'
						&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
						&AuditoriaTRN2.FromString(&GridStateDynamicFilter.Value)
				EndCase
				Do 'EnableDynamicFilters2'
				If &GridState.DynamicFilters.Count >= 3
					JSDynamicFilters.Caption += format(!"WWPDynFilterShow_AL('%1', 3, 0);", TableDynamicFilters.InternalName)
					AddDynamicFilters2.Visible = False
					RemoveDynamicFilters2.Visible = True
					&DynamicFiltersEnabled3 = True
					&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
					&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
					Do Case
						Case &DynamicFiltersSelector3 = !'AUDITORIATRN'
							&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
							&AuditoriaTRN3.FromString(&GridStateDynamicFilter.Value)
					EndCase
					Do 'EnableDynamicFilters3'
				EndIf
				JSDynamicFilters.Caption += !'});</script>'
			EndIf
	EndIf
	If &DynamicFiltersRemoving
		JSDynamicFilters.Caption = ''
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))

	// Save grid state in session.
	&GridState.OrderedBy = &OrderedBy
	&GridState.OrderedDsc = &OrderedDsc
	&GridState.FilterValues.Clear()
	WWP_GridStateAddFilterValue(&GridState, !"FILTERFULLTEXT", "WWP_FullTextFilterDescription", not &FilterFullText.IsEmpty(), 0, &FilterFullText, &FilterFullText, False, '', '')
	WWP_GridStateAddFilterValueAndSel(&GridState, !"TFAUDITORIATRN", "Transaccion", not &TFAuditoriaTRN.IsEmpty(), 0, &TFAuditoriaTRN, &TFAuditoriaTRN, False, '', '', not &TFAuditoriaTRN_Sel.IsEmpty(), &TFAuditoriaTRN_Sel, &TFAuditoriaTRN_Sel)
	WWP_GridStateAddFilterValueAndSel(&GridState, !"TFAUDITORIAPK", "Clave Primaria", not &TFAuditoriaPK.IsEmpty(), 0, &TFAuditoriaPK, &TFAuditoriaPK, False, '', '', not &TFAuditoriaPK_Sel.IsEmpty(), &TFAuditoriaPK_Sel, &TFAuditoriaPK_Sel)
	WWP_GridStateAddFilterValueAndSel(&GridState, !"TFAUDITORIAATTR", "Atributo", not &TFAuditoriaATTR.IsEmpty(), 0, &TFAuditoriaATTR, &TFAuditoriaATTR, False, '', '', not &TFAuditoriaATTR_Sel.IsEmpty(), &TFAuditoriaATTR_Sel, &TFAuditoriaATTR_Sel)
	WWP_GridStateAddFilterValueAndSel(&GridState, !"TFAUDITORIAOLDVALUE", "Valor Anterior", not &TFAuditoriaOldValue.IsEmpty(), 0, &TFAuditoriaOldValue, &TFAuditoriaOldValue, False, '', '', not &TFAuditoriaOldValue_Sel.IsEmpty(), &TFAuditoriaOldValue_Sel, &TFAuditoriaOldValue_Sel)
	WWP_GridStateAddFilterValueAndSel(&GridState, !"TFAUDITORIAVALUE", "Valor", not &TFAuditoriaValue.IsEmpty(), 0, &TFAuditoriaValue, &TFAuditoriaValue, False, '', '', not &TFAuditoriaValue_Sel.IsEmpty(), &TFAuditoriaValue_Sel, &TFAuditoriaValue_Sel)
	WWP_GridStateAddFilterValue(&GridState, !"TFAUDITORIAMODE_SEL", "Operacion Realizada", not &TFAuditoriaMode_Sels.Count = 0, 0, &TFAuditoriaMode_Sels.ToJson(), '', False, '', '')
	WWP_GridStateAddFilterValueAndSel(&GridState, !"TFAUDITORIAUSER", "Usuario", not &TFAuditoriaUser.IsEmpty(), 0, &TFAuditoriaUser, &TFAuditoriaUser, False, '', '', not &TFAuditoriaUser_Sel.IsEmpty(), &TFAuditoriaUser_Sel, &TFAuditoriaUser_Sel)
	WWP_GridStateAddFilterValue(&GridState, !"TFAUDITORIADATETIME", "del Evento", not (&TFAuditoriaDateTime.IsEmpty() AND &TFAuditoriaDateTime_To.IsEmpty()), 0, &TFAuditoriaDateTime.ToString().Trim(), iif(&TFAuditoriaDateTime.IsEmpty(), '', trim(&TFAuditoriaDateTime.ToFormattedString())), True, &TFAuditoriaDateTime_To.ToString().Trim(), iif(&TFAuditoriaDateTime_To.IsEmpty(), '', trim(&TFAuditoriaDateTime_To.ToFormattedString())))

	Do 'SaveDynFiltersState'

	&GridState.PageSize = str(Grid.Rows)
	&GridState.CurrentPage = Grid.CurrentPage
	SaveGridState.Call(&PgmName + !"GridState",  &GridState.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveDynFiltersState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.DynamicFilters.Clear()
	If not &DynamicFiltersIgnoreFirst
		&GridStateDynamicFilter = new()
		&GridStateDynamicFilter.Selected = &DynamicFiltersSelector1
		Do Case
			Case &DynamicFiltersSelector1 = !'AUDITORIATRN' AND not &AuditoriaTRN1.IsEmpty()
				WWP_GridStateAddDynFilterValue(&GridStateDynamicFilter, "Transaccion", &DynamicFiltersOperator1, &AuditoriaTRN1, format(!'%' + Trim(Str(&DynamicFiltersOperator1 + 1)), "WWP_FilterLike" + !' ' + &AuditoriaTRN1, "WWP_FilterContains" + !' ' + &AuditoriaTRN1), False, '', '')
		EndCase
		If &DynamicFiltersRemoving OR not &GridStateDynamicFilter.Value.IsEmpty()
			&GridState.DynamicFilters.Add(&GridStateDynamicFilter)
		EndIf
	EndIf
	If &DynamicFiltersEnabled2
		&GridStateDynamicFilter = new()
		&GridStateDynamicFilter.Selected = &DynamicFiltersSelector2
		Do Case
			Case &DynamicFiltersSelector2 = !'AUDITORIATRN' AND not &AuditoriaTRN2.IsEmpty()
				WWP_GridStateAddDynFilterValue(&GridStateDynamicFilter, "Transaccion", &DynamicFiltersOperator2, &AuditoriaTRN2, format(!'%' + Trim(Str(&DynamicFiltersOperator2 + 1)), "WWP_FilterLike" + !' ' + &AuditoriaTRN2, "WWP_FilterContains" + !' ' + &AuditoriaTRN2), False, '', '')
		EndCase
		If &DynamicFiltersRemoving OR not &GridStateDynamicFilter.Value.IsEmpty()
			&GridState.DynamicFilters.Add(&GridStateDynamicFilter)
		EndIf
	EndIf
	If &DynamicFiltersEnabled3
		&GridStateDynamicFilter = new()
		&GridStateDynamicFilter.Selected = &DynamicFiltersSelector3
		Do Case
			Case &DynamicFiltersSelector3 = !'AUDITORIATRN' AND not &AuditoriaTRN3.IsEmpty()
				WWP_GridStateAddDynFilterValue(&GridStateDynamicFilter, "Transaccion", &DynamicFiltersOperator3, &AuditoriaTRN3, format(!'%' + Trim(Str(&DynamicFiltersOperator3 + 1)), "WWP_FilterLike" + !' ' + &AuditoriaTRN3, "WWP_FilterContains" + !' ' + &AuditoriaTRN3), False, '', '')
		EndCase
		If &DynamicFiltersRemoving OR not &GridStateDynamicFilter.Value.IsEmpty()
			&GridState.DynamicFilters.Add(&GridStateDynamicFilter)
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = True
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"Auditoria.Auditoria"

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'DoExport'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Generate Excel spreadsheet and download it.
	Do 'LoadGridState'
	Auditoria.AuditoriaWWExport.Call(&ExcelFilename, &ErrorMessage)
	If (&ExcelFilename <> "")
		Link(&ExcelFilename)
	Else
		msg(&ErrorMessage)
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'DoExportReport'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Generate PDF file.
	Do 'LoadGridState'
	InNewWindow1.Target = Auditoria.AuditoriaWWExportReport.Link()
	InNewWindow1.Height = !'600'
	InNewWindow1.Width = !'800'
	InNewWindow1.OpenWindow()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub
