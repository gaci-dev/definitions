	}
	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated CuentaCorrEmpresa
				Case &TrnContextAtt.AttributeName = !"CuentaCorrEmpresa"
					&Insert_CuentaCorrEmpresa.FromString(&TrnContextAtt.AttributeValue)
					[web]
					{
					If not &Insert_CuentaCorrEmpresa.IsEmpty()
						&ComboCuentaCorrEmpresa = &Insert_CuentaCorrEmpresa
						Combo_CuentaCorrEmpresa.SelectedValue_set = &ComboCuentaCorrEmpresa.ToString().Trim()
						&Combo_DataJson = CuentaCorrLoadDVCombo(!'CuentaCorrEmpresa', !'GET', false, &CuentaCorrId, CuentaCorrCarrera, &TrnContextAtt.AttributeValue, &ComboSelectedValue, &ComboSelectedText)
						Combo_CuentaCorrEmpresa.SelectedText_set = &ComboSelectedText
						Combo_CuentaCorrEmpresa.Enabled = False
					EndIf
					}
				// When inserting with instantiated CuentaCorrCarrera
				Case &TrnContextAtt.AttributeName = !"CuentaCorrCarrera"
					&Insert_CuentaCorrCarrera.FromString(&TrnContextAtt.AttributeValue)
