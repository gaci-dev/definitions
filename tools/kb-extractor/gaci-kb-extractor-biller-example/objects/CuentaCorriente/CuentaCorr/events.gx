	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Combo_CuentaCorrCL_CarreraId.DataListProcParametersPrefix = format(!' "ComboName": "CuentaCorrCL_CarreraId", "TrnMode": "INS", "IsDynamicCall": true, "CuentaCorrId": 0, "Cond_CuentaCorrCarrera": "#%1#"', CuentaCorrCarrera.InternalName)
	&Combo_DataJson = CuentaCorrLoadDVCombo(!'CuentaCorrCL_CarreraId', &Mode, false, &CuentaCorrId, CuentaCorrCarrera, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_CuentaCorrCL_CarreraId.SelectedValue_set = &ComboSelectedValue
	Combo_CuentaCorrCL_CarreraId.SelectedText_set = &ComboSelectedText
	&ComboCuentaCorrCL_CarreraId = &ComboSelectedValue
	If &Mode = TrnMode.Display OR &Mode = TrnMode.Delete
		Combo_CuentaCorrCL_CarreraId.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

