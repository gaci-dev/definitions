				// When inserting with instantiated CuentaCorrCL_CarreraId
				Case &TrnContextAtt.AttributeName = !"CuentaCorrCL_CarreraId"
					&Insert_CuentaCorrCL_CarreraId.FromString(&TrnContextAtt.AttributeValue)
					[web]
					{
					If not &Insert_CuentaCorrCL_CarreraId.IsEmpty()
						&ComboCuentaCorrCL_CarreraId = &Insert_CuentaCorrCL_CarreraId
						Combo_CuentaCorrCL_CarreraId.SelectedValue_set = &ComboCuentaCorrCL_CarreraId
						&Combo_DataJson = CuentaCorrLoadDVCombo(!'CuentaCorrCL_CarreraId', !'GET', false, &CuentaCorrId, &Insert_CuentaCorrCarrera, &TrnContextAtt.AttributeValue, &ComboSelectedValue, &ComboSelectedText)
						Combo_CuentaCorrCL_CarreraId.SelectedText_set = &ComboSelectedText
